# =============================================================================
# Supevo Dashboard – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# `.env.local` wird NICHT eingecheckt.
# =============================================================================

# --- Supabase (Self-Hosting auf Plesk) --------------------------------------
# Öffentliche URL des selbst gehosteten Supabase-Stacks (Kong/Gateway).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.de

# Öffentlicher anon-Key. Darf im Browser landen (unterliegt RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GEHEIM: Service-Role-Key. NIEMALS mit NEXT_PUBLIC_ präfixen.
# Umgeht RLS – nur serverseitig verwenden.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anwendung ---------------------------------------------------------------
# Basis-URL der App (für Weiterleitungen, Einladungslinks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log-Level: debug | info | warn | error
LOG_LEVEL=info

# --- E-Mail-Versand (optional) ----------------------------------------------
# Entweder SMTP (nodemailer) ODER Resend konfigurieren. EMAIL_FROM ist Pflicht.
# Ohne Konfiguration ist der Versand ein protokollierter No-Op.
# EMAIL_FROM="Supevo <noreply@supevo.de>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# RESEND_API_KEY=

# --- Automatische Rechnungen (Cron) -----------------------------------------
# Geheimes Token, das der tägliche Cron-Job als Bearer mitschickt.
# CRON_SECRET=

# --- KI (Morgen-Briefing, optional) -----------------------------------------
# Ohne ANTHROPIC_API_KEY ist das KI-Briefing deaktiviert (die Karte erscheint
# dann nicht). Modell optional überschreibbar (Standard: claude-opus-5).
# Günstigere Alternative für das tägliche Briefing: claude-haiku-4-5
# ANTHROPIC_API_KEY=
# ANTHROPIC_BRIEFING_MODEL=claude-opus-5
