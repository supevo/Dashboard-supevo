# =============================================================================
# Supevo Dashboard – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# `.env.local` wird NICHT eingecheckt.
# =============================================================================

# --- Supabase (Self-Hosting auf Plesk) --------------------------------------
# Öffentliche URL des selbst gehosteten Supabase-Stacks (Kong/Gateway).
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.de

# Öffentlicher anon-Key. Darf im Browser landen (unterliegt RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GEHEIM: Service-Role-Key. NIEMALS mit NEXT_PUBLIC_ präfixen.
# Umgeht RLS – nur serverseitig verwenden.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anwendung ---------------------------------------------------------------
# Basis-URL der App (für Weiterleitungen, Einladungslinks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log-Level: debug | info | warn | error
LOG_LEVEL=info
