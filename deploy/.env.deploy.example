# =============================================================================
# Deployment environment for the app container (deploy/docker-compose.app.yml).
# Copy to deploy/.env.deploy and fill in real values. NEVER commit .env.deploy.
# =============================================================================

# Public URL of your self-hosted Supabase gateway (Kong), reachable from the
# browser. Example: https://api.supevo.de
NEXT_PUBLIC_SUPABASE_URL=https://api.supevo.de

# Supabase anon key (public, RLS-scoped). From your Supabase stack .env (ANON_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GEHEIM: service-role key. Server-side only. From your Supabase stack
# (SERVICE_ROLE_KEY). Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of THIS app (used for redirects, invitation links, CSRF origin).
# Example: https://app.supevo.de
NEXT_PUBLIC_APP_URL=https://app.supevo.de

# debug | info | warn | error
LOG_LEVEL=info
